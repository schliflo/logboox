{
	"name": "logboox",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"author": "Florian Schlittenbauer (https://github.com/schliflo)",
	"description": "LogbooX — explore an XPeng EU Data Act vehicle export entirely in the browser.",
	"repository": "https://github.com/schliflo/logboox",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:legacy": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --env legacy",
		"deploy": "pnpm build && wrangler deploy",
		"deploy:legacy": "PUBLIC_MOVED_TO=https://logboox.app vite build && wrangler deploy --env legacy",
		"deploy:cron": "wrangler deploy --config cron/wrangler.jsonc",
		"db:migrate": "wrangler d1 migrations apply logboox --remote",
		"db:migrate:local": "wrangler d1 migrations apply logboox --local",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json",
		"check:deploy": "node tooling/check-placeholders.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:smoke": "node tooling/smoke.ts",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.4",
		"clsx": "^2.1.1",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.146.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.49.0",
		"@pdf-lib/fontkit": "1.1.1",
		"@resvg/resvg-wasm": "2.6.2",
		"fflate": "^0.8.3",
		"layerchart": "^2.5.1",
		"mode-watcher": "^1.1.0",
		"pdf-lib": "1.17.1",
		"uplot": "^1.6.32"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
