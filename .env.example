# XPeng Open Platform credentials for `pnpm xpeng:query` (see docs/xpeng-open-platform.md).
# Copy to .env, which git ignores. Never commit real values.

# uat or prod; XPeng may issue separate appId/appSecret pairs for each.
XPENG_OPEN_ENV=prod

# Enterprise half: e-mailed by XPeng once the Open Platform application is approved.
XPENG_APP_ID=
XPENG_APP_SECRET=

# Owner half: e-mailed to the vehicle owner after authorising the enterprise in the Data Center.
XPENG_OPEN_ID=
XPENG_ACCESS_TOKEN=
# Byte for byte what the owner typed as the enterprise name.
XPENG_ENTERPRISE_NAME=LogbooX
XPENG_SCOPE_CODE=
